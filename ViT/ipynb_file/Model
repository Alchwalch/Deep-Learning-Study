ize,patch_size,in_channels=3,embed_dim=768):\n","      super().__init__()\n","\n","      assert patch_size > 0\n","      assert img_size % patch_size == 0\n","\n","      self.img_size=img_size\n","      self.patch_size=patch_size\n","      self.n_patches=(img_size//patch_size)**2\n","\n","      self.proj=nn.Conv2d(\n","          in_channels,\n","          embed_dim,\n","          kernel_size=patch_size,\n","          stride=patch_size\n","      )\n","\n","    def forward(self,x):\n","      x=self.proj(x)\n","      x=x.flatten(2) #(B,D,P,P) -> #(B,D,P^2)\n","      x=x.transpose(1,2)\n","      return x\n"],"metadata":{"id":"AvPQDrFdLyUJ","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792057329543,"user_tz":-540,"elapsed":44,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"eff94479-df63-4208-beea-dd75a9ef0590"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Appending to /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n"]}]},{"cell_type":"markdown","source":["# Attention"],"metadata":{"id":"p5wc1Sf7OXrj"}},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class MultiHeadAttention(nn.Module):\n","  def __init__(self, d_model, heads=12, attn_p=0.,proj_p=0.,qkv_bias=True):\n","    super(MultiHeadAttention,self).__init__()\n","    assert(d_model % heads == 0)\n","    self.d_model = d_model\n","    self.heads = heads\n","    self.head_dim = d_model // heads\n","\n","    self.qkv=nn.Linear(d_model,3*d_model,bias=qkv_bias)\n","    self.out_fc=nn.Linear(d_model,d_model,bias=qkv_bias)\n","    self.attn_p=nn.Dropout(attn_p)\n","    self.resid_dropout=nn.Dropout(proj_p)\n","\n","  def forward(self,x):\n","    batch_size, q_len, dim=x.shape\n","\n","    assert dim == self.d_model\n","\n","    qkv=self.qkv(x)\n","    qkv.reshape(batch_size,q_len,3,self.heads,self.head_dim)\n","    qkv=qkv.permute(2,0,3,1,4)\n","    q,k,v=qkv[0],qkv[1],qkv[2]\n","\n","    energy=torch.einsum(\"nqhd,nkhd->nhqk\",[q,k])\n","    disc_prob=torch.softmax(energy/(self.head_dim**(1/2)),dim=-1)\n","    disc_prob=self.attn_p(disc_prob)\n","\n","    out=torch.einsum(\"nhql,nlhd->nqhd\",[disc_prob,v])\n","    out=out.reshape(batch_size,q_len,self.d_model)\n","    out=self.out_fc(out)\n","    out=self.resid_dropout(out)\n","    return out"],"metadata":{"id":"oXN_CsNujG4H","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792062491027,"user_tz":-540,"elapsed":49,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"8c4d354e-ffe4-4b50-dea4-a051a4260f09"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Appending to /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n"]}]},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class FeedForward(nn.Module):\n","  def __init__(self,d_model,drop_p=0.,bias=True):\n","    super(FeedForward,self).__init__()\n","    self.layers=nn.Sequential(\n","        nn.Linear(d_model,d_model*4,bias=bias),\n","        nn.GELU(),\n","        nn.Dropout(drop_p),\n","        nn.Linear(d_model*4,d_model,bias=bias),\n","        nn.Dropout(drop_p)\n","    )\n","\n","  def forward(self,x):\n","    x=self.layers(x)\n","    return x"],"metadata":{"id":"pGBaD6rmP3wf"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class TransformerBlock(nn.Module):\n","  def __init__(self,cfg):\n","    super(TransformerBlock,self).__init__()\n","    self.norm1=nn.LayerNorm(cfg.d_model,bias=cfg.bias)\n","    self.attn=MultiHeadAttention(\n","        d_model=cfg.d_model,\n","        heads=cfg.heads,\n","        attn_p=cfg.attn_p,\n","        proj_p=cfg.proj_p,\n","        qkv_bias=cfg.bias\n","    )\n","    self.norm2=nn.LayerNorm(cfg.d_model,bias=cfg.bias)\n","    self.mlp=FeedForward(\n","        d_model=cfg.d_model,\n","        bias=cfg.bias\n","    )\n","\n","  def forward(self,x):\n","    x=x+self.attn(self.norm1(x))\n","    x=x+self.mlp(self.norm2(x))\n","    return x"],"metadata":{"id":"JmtSyPaNT0rB"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# ViT"],"metadata":{"id":"w5rzMzr3VwNX"}},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class VisionTransformer(nn.Module):\n","  def __init__(self, cfg):\n","    super().__init__()\n","    self.patch_embed = PatchEmbed(\n","        img_size=cfg.img_size,\n","        patch_size=cfg.patch_size,\n","        in_channels=cfg.in_channels,\n","        embed_dim=cfg.d_model\n","    )\n","    num_patches = (cfg.img_size // cfg.patch_size) ** 2\n","\n","    self.cls_token = nn.Parameter(torch.zeros(1, 1, cfg.d_model))\n","    self.pos_embed = nn.Embedding(1 + num_patches, cfg.d_model)\n","    self.pos_drop = nn.Dropout(cfg.pos_p)\n","\n","    self.blocks = nn.ModuleList(\n","        [TransformerBlock(cfg) for _ in range(cfg.n_layers)]\n","    )\n","    self.norm = nn.LayerNorm(cfg.d_model, bias=cfg.bias)\n","    self.head = nn.Linear(cfg.d_model, cfg.n_classes)\n","\n","    self.apply(self._init_weights)\n","    nn.init.trunc_normal_(self.cls_token, std=0.02)\n","\n","  def _init_weights(self, module):\n","    if isinstance(module, nn.Linear):\n","      nn.init.trunc_normal_(module.weight, std=0.02)\n","      if module.bias is not None:\n","        nn.init.zeros_(module.bias)\n","    elif isinstance(module, nn.Embedding):\n","      nn.init.trunc_normal_(module.weight, std=0.02)\n","    elif isinstance(module, nn.LayerNorm):\n","      nn.init.ones_(module.weight)\n","      if module.bias is not None:\n","        nn.init.zeros_(module.bias)\n","\n","    def forward(self, x):\n","      batch_size,seq_len=x.shape[0],x.shape[1]\n","      x = self.patch_embed(x)\n","      cls_token = self.cls_token.expand(batch_size, -1, -1)\n","      x = torch.cat((cls_token, x), dim=1)\n","      x=x+self.pos_embed(torch.arange(seq_len,device=x.device))\n","      x=self.pos_drop(x)\n","\n","      for block in self.blocks:\n","        x=block(x)\n","\n","      x=self.norm(x)\n","      cls_token_final=x[:,0]\n","      return self.head(cls_token_final)\n"],"metadata":{"id":"gqTXgjg-VJTY"},"execution_count":null,"outputs":[]}]}