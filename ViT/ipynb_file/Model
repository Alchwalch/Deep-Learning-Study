s":"ok","timestamp":1792287962409,"user_tz":-540,"elapsed":1517,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"73403595-8c43-4dbd-f8b6-b72f1a988a48"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Overwriting /content/drive/MyDrive/Github_proj//Deep-Learning-Study/ViT/model.py\n"]}]},{"cell_type":"markdown","source":["# Patch Embed"],"metadata":{"id":"1BGomUyCLzIv"}},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class PatchEmbed(nn.Module):\n","    def __init__(self,img_size,patch_size,in_channels=3,embed_dim=768):\n","      super().__init__()\n","\n","      assert patch_size > 0\n","      assert img_size % patch_size == 0\n","\n","      self.img_size=img_size\n","      self.patch_size=patch_size\n","      self.n_patches=(img_size//patch_size)**2\n","\n","      self.proj=nn.Conv2d(\n","          in_channels,\n","          embed_dim,\n","          kernel_size=patch_size,\n","          stride=patch_size\n","      )\n","\n","    def forward(self,x):\n","      x=self.proj(x)\n","      x=x.flatten(2) #(B,D,P,P) -> #(B,D,P^2)\n","      x=x.transpose(1,2)\n","      return x\n"],"metadata":{"id":"AvPQDrFdLyUJ","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792287962425,"user_tz":-540,"elapsed":14,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"89fb91bf-2e57-4191-9de9-ca2c70b07ee9"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Appending to /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n"]}]},{"cell_type":"markdown","source":["# Attention"],"metadata":{"id":"p5wc1Sf7OXrj"}},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class MultiHeadAttention(nn.Module):\n","  def __init__(self, d_model, heads=12, attn_p=0.,proj_p=0.,qkv_bias=True):\n","    super(MultiHeadAttention,self).__init__()\n","    assert(d_model % heads == 0)\n","    self.d_model = d_model\n","    self.heads = heads\n","    self.head_dim = d_model // heads\n","    self.attn_p = attn_p\n","\n","    self.qkv=nn.Linear(d_model,3*d_model,bias=qkv_bias)\n","    self.out_fc=nn.Linear(d_model,d_model,bias=qkv_bias)\n","    self.attn_dropout=nn.Dropout(attn_p)\n","    self.resid_dropout=nn.Dropout(proj_p)\n","\n","  def forward(self,x,return_attn=False):\n","    B, C, D=x.shape\n","    assert D == self.d_model\n","\n","    qkv=self.qkv(x).reshape(B,C,3,self.heads,self.head_dim)\n","    q, k, v=qkv.permute(2,0,3,1,4)\n","\n","    if return_attn:\n","      energy=q @ k.transpose(-1,-2)/(self.head_dim**(1/2))\n","      score=torch.softmax(energy,dim=-1)\n","      out=self.attn_dropout(score) @ v\n","    else:\n","      out= F.scaled_dot_product_attention(\n","          q,k,v,\n","          attn_mask=None,\n","          dropout_p=self.attn_p if self.training else 0.0,\n","          is_causal=False\n","      )\n","      score = None\n","\n","    out=out.transpose(1,2).reshape(B,C,D)\n","    out=self.out_fc(out)\n","    out=self.resid_dropout(out)\n","    return out,score"],"metadata":{"id":"oXN_CsNujG4H","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792287962448,"user_tz":-540,"elapsed":22,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"9921f983-67ee-40d4-cd45-afd4e2080183"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Appending to /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n"]}]},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class FeedForward(nn.Module):\n","  def __init__(self,d_model,drop_p=0.,bias=True):\n","    super(FeedForward,self).__init__()\n","    self.layers=nn.Sequential(\n","        nn.Linear(d_model,d_model*4,bias=bias),\n","        nn.GELU(),\n","        nn.Dropout(drop_p),\n","        nn.Linear(d_model*4,d_model,bias=bias),\n","        nn.Dropout(drop_p)\n","    )\n","\n","  def forward(self,x):\n","    x=self.layers(x)\n","    return x"],"metadata":{"id":"pGBaD6rmP3wf","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792287962464,"user_tz":-540,"elapsed":14,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"9f04e5b2-931e-48bb-fc88-6125777e92e4"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Appending to /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n"]}]},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class TransformerBlock(nn.Module):\n","  def __init__(self,cfg):\n","    super(TransformerBlock,self).__init__()\n","    self.norm1=nn.LayerNorm(cfg.d_model,bias=cfg.bias)\n","    self.attn=MultiHeadAttention(\n","        d_model=cfg.d_model,\n","        heads=cfg.heads,\n","        attn_p=cfg.attn_p,\n","        proj_p=cfg.proj_p,\n","        qkv_bias=cfg.bias\n","    )\n","    self.norm2=nn.LayerNorm(cfg.d_model,bias=cfg.bias)\n","    self.mlp=FeedForward(\n","        d_model=cfg.d_model,\n","        bias=cfg.bias\n","    )\n","\n","  def forward(self,x,return_attn=False):\n","    attn_out,score=self.attn(self.norm1(x),return_attn)\n","    x=x+attn_out\n","    x=x+self.mlp(self.norm2(x))\n","    return x,score"],"metadata":{"id":"JmtSyPaNT0rB","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792287962495,"user_tz":-540,"elapsed":28,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"7f00550e-e869-460a-a612-c54a43fb4ed2"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Appending to /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n"]}]},{"cell_type":"markdown","source":["# ViT"],"metadata":{"id":"w5rzMzr3VwNX"}},{"cell_type":"code","source":["%%writefile -a /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n","\n","class VisionTransformer(nn.Module):\n","  def __init__(self, cfg):\n","    super().__init__()\n","    self.patch_embed = PatchEmbed(\n","        img_size=cfg.img_size,\n","        patch_size=cfg.patch_size,\n","        in_channels=cfg.in_channels,\n","        embed_dim=cfg.d_model\n","    )\n","    num_patches = (cfg.img_size // cfg.patch_size) ** 2\n","\n","    self.cls_token = nn.Parameter(torch.zeros(1, 1, cfg.d_model))\n","    self.pos_embed = nn.Embedding(1 + num_patches, cfg.d_model)\n","    self.pos_drop = nn.Dropout(cfg.pos_p)\n","\n","    self.blocks = nn.ModuleList(\n","        [TransformerBlock(cfg) for _ in range(cfg.n_layers)]\n","    )\n","    self.norm = nn.LayerNorm(cfg.d_model, bias=cfg.bias)\n","    self.head = nn.Linear(cfg.d_model, cfg.n_classes)\n","\n","    self.apply(self._init_weights)\n","    nn.init.trunc_normal_(self.cls_token, std=0.02)\n","\n","  def _init_weights(self, module):\n","    if isinstance(module, nn.Linear):\n","      nn.init.trunc_normal_(module.weight, std=0.02)\n","      if module.bias is not None:\n","        nn.init.zeros_(module.bias)\n","    elif isinstance(module, nn.Embedding):\n","      nn.init.trunc_normal_(module.weight, std=0.02)\n","    elif isinstance(module, nn.LayerNorm):\n","      nn.init.ones_(module.weight)\n","      if module.bias is not None:\n","        nn.init.zeros_(module.bias)\n","\n","  def forward(self, x,return_attn=False):\n","    x = self.patch_embed(x)\n","    cls_token = self.cls_token.expand(x.size(0), -1, -1)\n","    x = torch.cat((cls_token, x), dim=1)\n","    x=x+self.pos_embed(torch.arange(x.size(1),device=x.device))\n","    x=self.pos_drop(x)\n","\n","    scores=[] if return_attn else None\n","    for block in self.blocks:\n","      x,score=block(x,return_attn)\n","      if return_attn:\n","        scores.append(score)\n","\n","    x=self.norm(x)\n","    cls_token_final=x[:,0]\n","    logits= self.head(cls_token_final)\n","    return (logits,scores) if return_attn else logits\n"],"metadata":{"id":"gqTXgjg-VJTY","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792287962499,"user_tz":-540,"elapsed":8,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"21b73ebd-df3f-4227-8f11-1eb842e594b9"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Appending to /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py\n"]}]},{"cell_type":"markdown","source":["# Smoke Test"],"metadata":{"id":"l9yLYm-orKD4"}},{"cell_type":"code","source":["from model import VisionTransformer"],"metadata":{"id":"za6nr0KbzUs3"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["class cfg:\n","  img_size=224\n","  patch_size=16\n","  in_channels=3\n","  n_classes=1000\n","  d_model=768\n","  n_layers=12\n","  heads=12\n","  bias=True\n","  pos_p=0.1\n","  attn_p=0.1\n","  proj_p=0.1"],"metadata":{"id":"eiDjCj8usIXI","executionInfo":{"status":"ok","timestamp":1792289876390,"user_tz":-540,"elapsed":14,"user":{"displayName":"Alchery","userId":"13707775072199463120"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["net = VisionTransformer(cfg)\n","print(net)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yWxW7349sM7H","executionInfo":{"status":"ok","timestamp":1792289888100,"user_tz":-540,"elapsed":1225,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"eb7fc442-25ec-4eb2-8ee5-21e7b4c89391"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["VisionTransformer(\n","  (patch_embed): PatchEmbed(\n","    (proj): Conv2d(3, 768, kernel_size=(16, 16), stride=(16, 16))\n","  )\n","  (pos_embed): Embedding(197, 768)\n","  (pos_drop): Dropout(p=0.1, inplace=False)\n","  (blocks): ModuleList(\n","    (0-11): 12 x TransformerBlock(\n","      (norm1): LayerNorm((768,), eps=1e-05, elementwise_affine=True)\n","      (attn): MultiHeadAttention(\n","        (qkv): Linear(in_features=768, out_features=2304, bias=True)\n","        (out_fc): Linear(in_features=768, out_features=768, bias=True)\n","        (attn_dropout): Dropout(p=0.1, inplace=False)\n","        (resid_dropout): Dropout(p=0.1, inplace=False)\n","      )\n","      (norm2): LayerNorm((768,), eps=1e-05, elementwise_affine=True)\n","      (mlp): FeedForward(\n","        (layers): Sequential(\n","          (0): Linear(in_features=768, out_features=3072, bias=True)\n","          (1): GELU(approximate='none')\n","          (2): Dropout(p=0.0, inplace=False)\n","          (3): Linear(in_features=3072, out_features=768, bias=True)\n","          (4): Dropout(p=0.0, inplace=False)\n","        )\n","      )\n","    )\n","  )\n","  (norm): LayerNorm((768,), eps=1e-05, elementwise_affine=True)\n","  (head): Linear(in_features=768, out_features=1000, bias=True)\n",")\n"]}]},{"cell_type":"code","source":["!ls /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT\n","!grep -n \"^import\\|^from\\|%%\" /content/drive/MyDrive/Github_proj/Deep-Learning-Study/ViT/model.py"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"j3HTcb3fyyx0","executionInfo":{"status":"ok","timestamp":1792289747689,"user_tz":-540,"elapsed":237,"user":{"displayName":"Alchery","userId":"13707775072199463120"}},"outputId":"70d494d8-5080-4296-8a1c-49c5d849e5fb"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["ipynb_file  model.py  __pycache__\n","2:import math\n","3:import matplotlib.pyplot as plt\n","4:import numpy as np\n","5:from collections import Counter,defaultdict\n","6:import torch\n","7:import torch.nn as nn\n","8:import torch.nn.functional as F\n","9:import torch.optim as optim\n","10:import torchvision\n","11:import torchvision.transforms as transforms\n","12:import torchvision.datasets a